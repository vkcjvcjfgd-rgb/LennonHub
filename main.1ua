-- ===== مطور يوسف HUB | Multi-Game =====
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")
local P = Players.LocalPlayer
local PG = P:WaitForChild("PlayerGui")
local Cam = workspace.CurrentCamera

-- كشف اللعبة الحالية
local function getGame()
    local name = string.lower(game.PlaceId .. " " .. game.Name)
    if string.find(name, "brainrot") then
        return "brainrot"
    elseif string.find(name, "blox") or game.PlaceId == 2753915549 then
        return "bloxfruits"
    elseif string.find(name, "egg") then
        return "stealegg"
    end
    return "unknown"
end

local currentGame = getGame()

local Window = Rayfield:CreateWindow({
    Name = "مطور يوسف HUB",
    LoadingTitle = "مطور يوسف HUB",
    LoadingSubtitle = "Multi-Game | " .. currentGame,
    ConfigurationSaving = { Enabled = false },
    KeySystem = false,
})

-- ==========================================
-- 🏠 Main Tab
-- ==========================================
local MainTab = Window:CreateTab("الرئيسية", nil)

MainTab:CreateSection("معلومات")
MainTab:CreateParagraph({
    Title = "مطور يوسف HUB",
    Content = "اللعبة المكتشفة: " .. currentGame .. "\nTelegram: t.me/YJW_m",
})

MainTab:CreateButton({
    Name = "📋 نسخ رابط قناتي",
    Callback = function()
        setclipboard("https://t.me/YJW_m")
        Rayfield:Notify({Title = "مطور يوسف", Content = "تم نسخ الرابط ✅", Duration = 2})
    end,
})

-- ==========================================
-- 🎮 Player Tab (يعمل في كل الألعاب)
-- ==========================================
local PlayerTab = Window:CreateTab("اللاعب", nil)

PlayerTab:CreateSection("الحركة")

local speed = 16
PlayerTab:CreateSlider({
    Name = "🏃 السرعة",
    Range = {16, 300},
    Increment = 1,
    Suffix = "Speed",
    CurrentValue = 16,
    Flag = "Speed",
    Callback = function(v) speed = v end,
})

local jump = 50
PlayerTab:CreateSlider({
    Name = "🦘 القفز",
    Range = {50, 500},
    Increment = 5,
    Suffix = "Power",
    CurrentValue = 50,
    Flag = "Jump",
    Callback = function(v) jump = v end,
})

_G.infJump = false
PlayerTab:CreateToggle({
    Name = "🦅 قفز لا نهائي",
    CurrentValue = false,
    Flag = "InfJump",
    Callback = function(v) _G.infJump = v end,
})

_G.fly = false
PlayerTab:CreateToggle({
    Name = "✈️ طيران (Fly)",
    CurrentValue = false,
    Flag = "Fly",
    Callback = function(v) _G.fly = v end,
})

_G.nc = false
PlayerTab:CreateToggle({
    Name = "👻 Noclip",
    CurrentValue = false,
    Flag = "Noclip",
    Callback = function(v) _G.nc = v end,
})

task.spawn(function()
    while task.wait(0.1) do
        local c = P.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed = speed; h.JumpPower = jump end
        end
    end
end)

UIS.JumpRequest:Connect(function()
    if _G.infJump then
        local c = P.Character
        if c and c:FindFirstChildOfClass("Humanoid") then
            c:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
        end
    end
end)

RunService.Stepped:Connect(function()
    if _G.nc and P.Character then
        for _, p in pairs(P.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

task.spawn(function()
    while task.wait() do
        if _G.fly then
            local c = P.Character
            if c then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp and not hrp:FindFirstChild("YF") then
                    local g = Instance.new("BodyGyro", hrp); g.Name = "YF"
                    g.P = 9e4; g.MaxTorque = Vector3.new(9e9,9e9,9e9); g.CFrame = hrp.CFrame
                    local v = Instance.new("BodyVelocity", hrp); v.Name = "YFV"
                    v.Velocity = Vector3.new(0,0,0); v.MaxForce = Vector3.new(9e9,9e9,9e9)
                end
                if hrp then
                    local v = hrp:FindFirstChild("YFV")
                    if v then
                        local m = Vector3.new(0,0,0)
                        if UIS:IsKeyDown(Enum.KeyCode.W) then m = m + Cam.CFrame.LookVector end
                        if UIS:IsKeyDown(Enum.KeyCode.S) then m = m - Cam.CFrame.LookVector end
                        if UIS:IsKeyDown(Enum.KeyCode.A) then m = m - Cam.CFrame.RightVector end
                        if UIS:IsKeyDown(Enum.KeyCode.D) then m = m + Cam.CFrame.RightVector end
                        if UIS:IsKeyDown(Enum.KeyCode.Space) then m = m + Vector3.new(0,1,0) end
                        v.Velocity = m * 80
                    end
                end
            end
        end
    end
end)

-- ==========================================
-- 🧠 Steal a Brainrot Tab
-- ==========================================
if currentGame == "brainrot" or currentGame == "unknown" then
    local SabTab = Window:CreateTab("🧠 Brainrot", nil)
    SabTab:CreateSection("Combat")
    
    local batAim = false
    SabTab:CreateToggle({
        Name = "🎯 Bat Aimbot",
        CurrentValue = false,
        Flag = "BatAim",
        Callback = function(v) batAim = v end,
    })
    
    task.spawn(function()
        while task.wait(0.1) do
            if batAim and P.Character then
                local hrp = P.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local closest, dist = nil, math.huge
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= P and plr.Character then
                            local t = plr.Character:FindFirstChild("HumanoidRootPart")
                            if t then
                                local d = (t.Position - hrp.Position).Magnitude
                                if d < dist and d < 50 then dist = d; closest = t end
                            end
                        end
                    end
                    if closest then
                        hrp.CFrame = CFrame.new(hrp.Position, closest.Position)
                    end
                end
            end
        end
    end)
    
    SabTab:CreateButton({
        Name = "💾 حفظ الموقع",
        Callback = function()
            local c = P.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                _G.savedPos = c.HumanoidRootPart.CFrame
                Rayfield:Notify({Title = "مطور يوسف", Content = "تم حفظ الموقع ✅", Duration = 2})
            end
        end,
    })
    
    SabTab:CreateButton({
        Name = "🚀 العودة للموقع المحفوظ",
        Callback = function()
            local c = P.Character
            if c and c:FindFirstChild("HumanoidRootPart") and _G.savedPos then
                c.HumanoidRootPart.CFrame = _G.savedPos
            end
        end,
    })
end

-- ==========================================
-- 🍎 Blox Fruits Tab
-- ==========================================
if currentGame == "bloxfruits" or currentGame == "unknown" then
    local BfTab = Window:CreateTab("🍎 Blox Fruits", nil)
    BfTab:CreateSection("ESP")
    
    local espObjects = {}
    local function createESP(part, txt, color)
        if espObjects[part] then return end
        local bb = Instance.new("BillboardGui", part)
        bb.Size = UDim2.new(0, 150, 0, 35)
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.AlwaysOnTop = true
        local l = Instance.new("TextLabel", bb)
        l.Size = UDim2.new(1, 0, 1, 0)
        l.BackgroundTransparency = 0.3
        l.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        l.TextColor3 = color or Color3.fromRGB(255, 220, 50)
        l.Font = Enum.Font.GothamBold
        l.TextSize = 12
        l.Text = txt
        l.Parent = bb
        espObjects[part] = bb
    end
    
    local function clearESP()
        for _, g in pairs(espObjects) do
            if g and g.Parent then g:Destroy() end
        end
        espObjects = {}
    end
    
    local espFruits = false
    local espChests = false
    local espPlayers = false
    
    BfTab:CreateToggle({
        Name = "🍎 ESP Fruits",
        CurrentValue = false,
        Flag = "EspFruits",
        Callback = function(v) espFruits = v; if not v then clearESP() end end,
    })
    
    BfTab:CreateToggle({
        Name = "📦 ESP Chests",
        CurrentValue = false,
        Flag = "EspChests",
        Callback = function(v) espChests = v; if not v then clearESP() end end,
    })
    
    BfTab:CreateToggle({
        Name = "👤 ESP Players",
        CurrentValue = false,
        Flag = "EspPlayers",
        Callback = function(v) espPlayers = v; if not v then clearESP() end end,
    })
    
    task.spawn(function()
        while task.wait(2) do
            if espFruits or espChests or espPlayers then
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local n = string.lower(obj.Name)
                        local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                        if part then
                            if espFruits and string.find(n, "fruit") then
                                createESP(part, "🍎 " .. obj.Name, Color3.fromRGB(255, 180, 50))
                            end
                            if espChests and string.find(n, "chest") then
                                createESP(part, "📦 " .. obj.Name, Color3.fromRGB(255, 220, 50))
                            end
                        end
                    end
                end
                if espPlayers then
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= P and plr.Character then
                            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                createESP(hrp, "👤 " .. plr.Name, Color3.fromRGB(80, 220, 120))
                            end
                        end
                    end
                end
            end
        end
    end)
end

-- ==========================================
-- 🥚 Steal an Egg Tab
-- ==========================================
if currentGame == "stealegg" or currentGame == "unknown" then
    local EggTab = Window:CreateTab("🥚 Steal an Egg", nil)
    EggTab:CreateSection("Steal")
    
    local autoSteal = false
    local stealSpeed = 0.5
    
    EggTab:CreateToggle({
        Name = "⚡ سرقة فورية",
        CurrentValue = false,
        Flag = "AutoSteal",
        Callback = function(v) autoSteal = v end,
    })
    
    EggTab:CreateSlider({
        Name = "⚡ سرعة السرقة",
        Range = {1, 10},
        Increment = 1,
        Suffix = "x10ms",
        CurrentValue = 5,
        Flag = "StealSpeed",
        Callback = function(v) stealSpeed = v / 10 end,
    })
    
    task.spawn(function()
        while task.wait(stealSpeed) do
            if autoSteal and P.Character then
                local hrp = P.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local closest, dist = nil, math.huge
                    for _, o in pairs(workspace:GetDescendants()) do
                        if o:IsA("BasePart") and string.find(string.lower(o.Name), "egg") then
                            local d = (o.Position - hrp.Position).Magnitude
                            if d < dist then dist = d; closest = o end
                        end
                    end
                    if closest then
                        pcall(function() hrp.CFrame = closest.CFrame + Vector3.new(0, 2, 0) end)
                    end
                end
            end
        end
    end)
    
    EggTab:CreateButton({
        Name = "🚀 روح لأقرب بيضة",
        Callback = function()
            local c = P.Character
            if not c then return end
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local cl, d = nil, math.huge
            for _, o in pairs(workspace:GetDescendants()) do
                if o:IsA("BasePart") and string.find(string.lower(o.Name), "egg") then
                    local dd = (o.Position - hrp.Position).Magnitude
                    if dd < d then d = dd; cl = o end
                end
            end
            if cl then pcall(function() hrp.CFrame = cl.CFrame + Vector3.new(0, 3, 0) end) end
        end,
    })
    
    EggTab:CreateButton({
        Name = "💰 بيع البيض",
        Callback = function()
            for _, o in pairs(RS:GetDescendants()) do
                if o:IsA("RemoteEvent") and string.find(string.lower(o.Name), "sell") then
                    pcall(function() o:FireServer() end)
                end
            end
        end,
    })
end

